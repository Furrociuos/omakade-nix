[Desktop Entry]
Type=Application
Name=Omakade
Comment=Your games, beautifully together
Exec=omakade
Icon=io.github.tsouth89.Omakade
Terminal=false
Categories=Game;
Keywords=Games;Launcher;Library;
StartupNotify=true
StartupWMClass=io.github.tsouth89.Omakade
Actions=GameMode;

[Desktop Action GameMode]
Name=Game Mode
Exec=omakade --game-mode
